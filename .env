# ==========================================================================
# 通用环境变量（所有模式都会加载）
# --------------------------------------------------------------------------
# Vite 加载 .env 文件的顺序：
#   .env                  ← 本文件，任何模式都会读到
#   .env.local            ← 本机私有覆盖（已被 .gitignore 忽略，不要提交）
#   .env.[mode]           ← 如 .env.development、.env.production
#   .env.[mode].local
# 同名变量「后加载的覆盖先加载的」，所以 .env.development 可以覆盖这里的值。
#
# 只有 VITE_ 开头的变量会注入到浏览器代码（import.meta.env.VITE_XXX）。
# ==========================================================================

# 应用名称：用于浏览器标签页标题（index.html 里的 %VITE_APP_NAME%）和页面品牌名
VITE_APP_NAME=AI agent

# 应用版本：显示在导航栏与页脚
VITE_APP_VERSION=1.0.0

# 后端 API 基址：所有 axios 请求的 baseURL
# 本地后端没启动时，首页会显示「未连接」提示，但页面本身仍可浏览
VITE_API_BASE=http://localhost:3001
