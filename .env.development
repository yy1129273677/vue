# 开发环境配置 (Development environment)
# 以 VITE_ 开头的变量会通过 import.meta.env 暴露给客户端代码

# 应用标题
VITE_APP_TITLE=Demo1 (Dev)

# 开发服务器端口
VITE_PORT=5173

# 是否自动打开浏览器
VITE_OPEN=true

# API 基础地址（被 vite.config.js 的 proxy 使用）
VITE_API_BASE=http://localhost:3000

# 应用版本
VITE_APP_VERSION=1.0.0

PORT=3000

API_BASE='/api/'
