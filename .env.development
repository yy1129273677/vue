# ==========================================================================
# 开发环境配置（npm run dev 时加载，覆盖 .env 里的同名变量）
# --------------------------------------------------------------------------
# 命名规则（非常重要）：
#   · 以 VITE_ 开头的变量会被 Vite 注入到前端代码，
#     通过 import.meta.env.VITE_XXX 读取（类型声明见 src/vite-env.d.ts）。
#   · 不以 VITE_ 开头的变量（如下面的 PORT）只在 Node 环境可见，
#     前端代码读不到，主要用于给后端或工具链使用。
#
# 修改后需要重启 npm run dev 才会生效。
# ==========================================================================

# 开发服务器端口
VITE_PORT=5173

# 启动开发服务器后是否自动打开浏览器（true / false）
VITE_OPEN=true

# 本机后端地址（留空则使用 .env 里的默认值 http://localhost:3001）
# 例如后端跑在别的机器上：VITE_API_BASE=http://192.168.1.10:3001
VITE_API_BASE=http://localhost:3001

# --------------------------------------------------------------------------
# 下面两个变量不以 VITE_ 开头，前端读不到，供后端/工具使用
# --------------------------------------------------------------------------
PORT=3001
API_BASE='/api/'
